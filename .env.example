# Sao chép thành .env rồi điền giá trị.
# API và worker validate file này lúc khởi động (apps/api/src/config/env.schema.ts):
# thiếu biến bắt buộc hoặc sai kiểu thì không khởi động.

# LLM phân loại và trích xuất (ADR 0008). Worker bắt buộc có; process API không cần.
# Để trống "ANTHROPIC_API_KEY=" bị coi là chuỗi rỗng (lỗi), nên chưa có key thì để dòng comment.
# ANTHROPIC_API_KEY=

# Bắt buộc. Postgres chạy bằng docker compose (make db-up)
DATABASE_URL=postgres://credflow:credflow@localhost:5432/credflow

# Bắt buộc. Redis cho BullMQ, chạy bằng docker compose (make db-up)
REDIS_URL=redis://localhost:6379

# Nơi lưu file upload và dữ liệu giả lập (mặc định ./data)
DATA_DIR=./data

# API (mặc định 127.0.0.1:8787)
API_HOST=127.0.0.1
API_PORT=8787

# Đăng nhập (ADR 0004). Session hết hạn sau N ngày (mặc định 7).
SESSION_TTL_DAYS=7
# Cookie chỉ gửi qua HTTPS. Dev chạy http nên để false; bật true khi deploy.
COOKIE_SECURE=false
# User giả lập do `make db-seed` tạo: staff@example.test, reviewer@example.test, admin@example.test.
# DATABASE_URL ở máy local: mật khẩu dev chung "credflow-dev". Database ở nơi khác (Railway):
# bắt buộc SEED_PASSWORD riêng, ít nhất 12 ký tự, không được là "credflow-dev" (plan 33).
# SEED_PASSWORD=

# Upload (plan 11): giới hạn dung lượng một file, tính bằng byte (mặc định 10 MB).
# File lưu dưới DATA_DIR/files, file tạm dưới DATA_DIR/tmp.
UPLOAD_MAX_BYTES=10485760

# Nơi lưu file (plan 33, ADR 0013): local (mặc định, đĩa dưới DATA_DIR) hoặc s3 (bucket tương thích S3).
# Production trên Railway dùng s3 vì api và worker là hai container không chung đĩa. Trên Railway đặt
# bằng reference variable: S3_BUCKET=${{Bucket.BUCKET}}, S3_ENDPOINT=${{Bucket.ENDPOINT}},
# S3_REGION=${{Bucket.REGION}}, S3_ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}},
# S3_SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}}. STORAGE_DRIVER=s3 mà thiếu biến → không khởi động.
# STORAGE_DRIVER=local
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false   # true nếu tab Credentials của bucket ghi path-style

# Thư mục cấu hình rule (default.yaml + clients/<clientId>.yaml, plan 25). Worker đọc lúc khởi động;
# file nào sai thì không khởi động. Tính từ apps/api.
RULES_CONFIG_PATH=../../config/rules

# Web (Next.js đọc, không thuộc schema của API)
WEB_PORT=3000
