# Sao chép thành .env rồi điền giá trị.
# API và worker validate file này lúc khởi động (apps/api/src/config/env.schema.ts):
# thiếu biến bắt buộc hoặc sai kiểu thì không khởi động.

# LLM có vision để phân loại và trích xuất (model cụ thể chốt ở P1, ghi ADR)
# Tuỳ chọn đến P1. Để trống "ANTHROPIC_API_KEY=" bị coi là chuỗi rỗng (lỗi), nên chưa có key thì để dòng comment.
# ANTHROPIC_API_KEY=

# Bắt buộc. Postgres chạy bằng docker compose (make db-up)
DATABASE_URL=postgres://credflow:credflow@localhost:5432/credflow

# Bắt buộc. Redis cho BullMQ, chạy bằng docker compose (make db-up)
REDIS_URL=redis://localhost:6379

# Nơi lưu file upload và dữ liệu giả lập (mặc định ./data)
DATA_DIR=./data

# API (mặc định 127.0.0.1:8787)
API_HOST=127.0.0.1
API_PORT=8787

# Đăng nhập (ADR 0004). Session hết hạn sau N ngày (mặc định 7).
SESSION_TTL_DAYS=7
# Cookie chỉ gửi qua HTTPS. Dev chạy http nên để false; bật true khi deploy.
COOKIE_SECURE=false
# User giả lập do `make db-seed` tạo: staff@example.test, reviewer@example.test, admin@example.test,
# mật khẩu dev chung "credflow-dev" (apps/api/scripts/seed-data.ts). Chỉ dùng với dữ liệu giả lập.

# Web (Next.js đọc, không thuộc schema của API)
WEB_PORT=3000
