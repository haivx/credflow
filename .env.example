# Sao chép thành .env rồi điền giá trị.

# LLM có vision để phân loại và trích xuất (model cụ thể chốt ở P1, ghi ADR)
ANTHROPIC_API_KEY=

# Postgres chạy bằng docker compose (make db-up)
DATABASE_URL=postgres://credflow:credflow@localhost:5432/credflow

# Nơi lưu file upload và dữ liệu giả lập
DATA_DIR=./data

# Cổng
API_PORT=8787
WEB_PORT=3000
