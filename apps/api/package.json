{
  "name": "@credflow/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@credflow/contracts": "workspace:*",
    "@credflow/rules": "workspace:*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.20",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.12"
  }
}
