{
  "name": "@credflow/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run --passWithNoTests",
    "test:int": "vitest run --config vitest.int.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset-demo-password": "tsx scripts/reset-demo-password.ts",
    "eval": "tsx scripts/eval.ts",
    "report:corrections": "tsx scripts/report-corrections.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@aws-sdk/client-s3": "3.1156.0",
    "@credflow/contracts": "workspace:*",
    "@credflow/rules": "workspace:*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/throttler": "6.7.1",
    "bullmq": "^6.5.4",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^10.9.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ulid": "^3.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.20",
    "@types/busboy": "^1.5.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.12"
  }
}
